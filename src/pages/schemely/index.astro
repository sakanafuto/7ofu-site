---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Spread from '../../components/Spread.astro';
import DocIndex from '../../components/DocIndex.astro';
import { getApp } from '../../data/apps';

const lang = 'ja';
const app = getApp('schemely', lang);

const articles = [
  {
    href: '/blog/universal-link-ga-hirakanai/',
    title: 'Universal Link が「開かない」全パターン',
    desc: 'iOS 実機で切り分けた Deep Link のハマりどころ',
  },
];

const docs = [
  { href: '/schemely/terms', title: '利用規約', desc: 'アプリの利用条件' },
  { href: '/schemely/privacy', title: 'プライバシーポリシー', desc: '情報の取扱い（データ収集なし）' },
];

const contact = [
  { href: '/schemely/contact', title: 'お問い合わせフォーム', desc: '要望・不具合の報告など' },
];
---

<BaseLayout title="Schemely | 7ofu" description="Schemely の規約・ポリシー" width="wide">
  <p class="crumb"><a href="/">Home</a> / Schemely</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section class="doc-section">
    <DocIndex label="解説記事" items={articles} />
  </section>

  <section class="doc-section">
    <DocIndex label="規約・ポリシー" items={docs} />
  </section>

  <section class="doc-section">
    <DocIndex label="お問い合わせ" items={contact} />
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doc-section { margin-top: 3rem; }
  </style>
</BaseLayout>
