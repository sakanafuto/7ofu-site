---
import BaseLayout from '../layouts/BaseLayout.astro';
import Spread from '../components/Spread.astro';
import { getApps } from '../data/apps';

const lang = 'ja';
const apps = getApps(lang);
---

<BaseLayout title="7ofu" width="wide" tortoise>
  <section class="cover">
    <p class="cover__label label-hand">FIELD NOTES / 観察ノート</p>
    <h1 class="cover__title display">7ofu</h1>
    <p class="cover__lead">小さなものをつくって、観察しています。</p>
    <p class="cover__turn">ページをめくる ↓</p>
  </section>

  {
    apps.map((app, index) => (
      <Spread
        app={app}
        lang={lang}
        index={index}
        reverse={index % 2 === 1}
        eager={index === 0}
        maxShots={2}
      />
    ))
  }

  <section class="colophon">
    <h2 class="colophon__label">巻末メモ</h2>
    <ul class="colophon__list">
      <li>
        <a href="/blog/">
          <strong>Blog</strong>
          <small>iOS 開発でハマったことや、アプリの裏側のメモ。</small>
        </a>
      </li>
      <li>
        <a href="https://x.com/KouraDiary" target="_blank" rel="noopener">
          <strong>X（旧Twitter）</strong>
          <small>@KouraDiary・更新のお知らせなど。</small>
        </a>
      </li>
    </ul>
  </section>

  <style>
    .cover {
      position: relative;
      min-height: min(68vh, 32rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 2.3rem;
      background-image: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 2.3rem,
        var(--rule) 2.3rem,
        var(--rule) calc(2.3rem + 1px)
      );
    }
    .cover__label {
      margin: 0;
      line-height: 2.3rem;
      font-size: 1.1rem;
      color: var(--muted);
    }
    .cover__title {
      display: inline-block;
      width: fit-content;
      margin-block: 2.3rem;
      margin-inline: -0.15em;
      padding-inline: 0.15em;
      background: var(--bg);
      color: var(--brand);
      font-size: clamp(4rem, 12vw, 9rem);
      line-height: 1;
    }
    .cover__lead {
      margin: 0;
      line-height: 2.3rem;
      max-width: 32rem;
      color: var(--fg);
      font-size: 1.1rem;
    }
    .cover__turn {
      margin: 0;
      margin-top: auto;
      line-height: 2.3rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .colophon {
      margin-top: 2.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--rule);
    }
    .colophon__label {
      margin: 0 0 1.25rem;
      font-size: 1rem;
      color: var(--muted);
      border: none;
      padding: 0;
    }
    .colophon__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.85rem;
      max-width: 26rem;
    }
    .colophon__list a {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 1rem 1.15rem;
      border: 1px solid var(--rule);
      border-radius: 12px;
      text-decoration: none;
      color: var(--fg);
      transition: border-color 0.15s ease;
    }
    .colophon__list a:hover {
      border-color: var(--brand);
    }
    .colophon__list small {
      color: var(--muted);
    }
  </style>
</BaseLayout>
