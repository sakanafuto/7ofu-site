---
import BaseLayout from '../layouts/BaseLayout.astro';
import Spread from '../components/Spread.astro';
import MarginNote from '../components/MarginNote.astro';
import DocIndex from '../components/DocIndex.astro';
import { getApps } from '../data/apps';

const lang = 'ja';
const apps = getApps(lang);
// Home は主役 2 アプリ（こうら日記・カメコロ）だけ見開きにする。Schemely は巻末手前の余白メモ
// として軽く置く（開発者向けツールを同じ粒度で並べると主役がぼける・adr/0008 追記2）。
const spreadApps = apps.filter((app) => app.homeLayout === 'spread');
const noteApps = apps.filter((app) => app.homeLayout === 'note');

const colophonItems = [
  {
    href: '/blog/',
    title: 'Blog',
    desc: 'iOS 開発でハマったことや、アプリの裏側のメモ。',
  },
  {
    href: 'https://x.com/KouraDiary',
    title: 'X（旧Twitter）',
    desc: '@KouraDiary・更新のお知らせなど。',
    external: true,
  },
  {
    href: '/contact/',
    title: 'お問い合わせ',
    desc: 'ご意見・ご要望はこちらから。',
  },
];
---

<BaseLayout title="7ofu" width="wide" tortoise>
  <section class="cover">
    <p class="cover__label label-hand">FIELD NOTES / 観察ノート</p>
    <h1 class="cover__title display">7ofu</h1>
    <p class="cover__lead">小さなものをつくって、観察しています。</p>
    <p class="cover__turn">ページをめくる ↓</p>
  </section>

  {
    spreadApps.map((app, index) => (
      <Spread
        app={app}
        lang={lang}
        index={index}
        reverse={index % 2 === 1}
        eager={index === 0}
        maxShots={2}
      />
    ))
  }

  {noteApps.map((app) => <MarginNote app={app} lang={lang} />)}

  <section class="colophon">
    <DocIndex label="巻末メモ" items={colophonItems} />
  </section>

  <style>
    .cover {
      position: relative;
      min-height: min(68vh, 32rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 2.3rem;
      background-image: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 2.3rem,
        var(--rule) 2.3rem,
        var(--rule) calc(2.3rem + 1px)
      );
    }
    .cover__label {
      margin: 0;
      line-height: 2.3rem;
      font-size: 1.1rem;
      color: var(--muted);
    }
    .cover__title {
      display: inline-block;
      width: fit-content;
      margin-block: 2.3rem;
      margin-inline: -0.15em;
      padding-inline: 0.15em;
      background: var(--bg);
      color: var(--brand);
      font-size: clamp(4rem, 12vw, 9rem);
      line-height: 1;
    }
    .cover__lead {
      margin: 0;
      line-height: 2.3rem;
      max-width: 32rem;
      color: var(--fg);
      font-size: 1.1rem;
    }
    .cover__turn {
      margin: 0;
      margin-top: auto;
      line-height: 2.3rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .colophon {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
    }
  </style>
</BaseLayout>
