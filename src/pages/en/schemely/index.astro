---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Spread from '../../../components/Spread.astro';
import DocIndex from '../../../components/DocIndex.astro';
import { getApp } from '../../../data/apps';

const lang = 'en';
const app = getApp('schemely', lang);

const docs = [
  { href: '/en/schemely/terms', title: 'Terms of Use', desc: 'Conditions for using the app' },
  { href: '/en/schemely/privacy', title: 'Privacy Policy', desc: 'How your data is handled (no data collection)' },
];

const contact = [
  { href: '/en/schemely/contact', title: 'Contact form', desc: 'Requests, bug reports, and more' },
];
---

<BaseLayout title="Schemely | 7ofu" description="Schemely terms and policies" width="wide">
  <p class="crumb"><a href="/en/">Home</a> / Schemely</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section class="doc-section">
    <DocIndex label="Terms & Policies" items={docs} />
  </section>

  <section class="doc-section">
    <DocIndex label="Contact" items={contact} />
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doc-section { margin-top: 3rem; }
  </style>
</BaseLayout>
