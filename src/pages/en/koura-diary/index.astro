---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Spread from '../../../components/Spread.astro';
import DocIndex from '../../../components/DocIndex.astro';
import { getApp } from '../../../data/apps';

const lang = 'en';
const app = getApp('koura', lang);

const howto = [
  { href: '/en/koura-diary/help', title: 'How to use / Help', desc: 'Recording, family sharing, backup, and more' },
];

const docs = [
  { href: '/en/koura-diary/terms', title: 'Terms of Use', desc: 'Conditions for using the app' },
  { href: '/en/koura-diary/privacy', title: 'Privacy Policy', desc: 'How your information is handled' },
  { href: '/en/koura-diary/account-deletion', title: 'Account & Data Deletion', desc: 'How to delete your account and data' },
  { href: '/en/koura-diary/disclaimer', title: 'Disclaimer', desc: 'About health and nutrition information' },
];
---

<BaseLayout title="Koura Diary | 7ofu" description="Koura Diary help and legal pages" width="wide">
  <p class="crumb"><a href="/en/">Home</a> / Koura Diary</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section class="doc-section">
    <DocIndex label="How to use" items={howto} />
  </section>

  <section class="doc-section">
    <DocIndex label="Terms & Policies" items={docs} />
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doc-section { margin-top: 3rem; }
  </style>
</BaseLayout>
