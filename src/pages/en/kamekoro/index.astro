---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Spread from '../../../components/Spread.astro';
import { getApp } from '../../../data/apps';

const lang = 'en';
const app = getApp('kamekoro', lang);

const docs = [
  { href: '/en/kamekoro/terms', title: 'Terms of Use', desc: 'Conditions for using the app' },
  { href: '/en/kamekoro/privacy', title: 'Privacy Policy', desc: 'How your data is handled' },
];
---

<BaseLayout title="Kamekoro | 7ofu" description="Kamekoro terms, policies, and contact" width="wide">
  <p class="crumb"><a href="/en/">Home</a> / Kamekoro</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section>
    <h2>Terms &amp; Policies</h2>
    <ul class="doclist">
      {docs.map((d) => (
        <li>
          <a href={d.href}>
            <strong>{d.title}</strong>
            <small>{d.desc}</small>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Contact</h2>
    <ul class="doclist">
      <li>
        <a href="/en/kamekoro/contact">
          <strong>Contact form</strong>
          <small>Requests, bug reports, reporting a nickname, and more</small>
        </a>
      </li>
    </ul>
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doclist {
      list-style: none;
      padding: 0;
      margin: 0;
      max-width: 40rem;
      display: grid;
      gap: 1rem;
    }
    .doclist a {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1.15rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: white;
      text-decoration: none;
      color: var(--fg);
      transition: border-color 0.15s ease;
    }
    .doclist a:hover { border-color: var(--brand); }
    .doclist small { color: var(--muted); }
  </style>
</BaseLayout>
