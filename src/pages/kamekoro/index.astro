---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Spread from '../../components/Spread.astro';
import { getApp } from '../../data/apps';

const lang = 'ja';
const app = getApp('kamekoro', lang);

const docs = [
  { href: '/kamekoro/terms', title: '利用規約', desc: 'アプリの利用条件' },
  { href: '/kamekoro/privacy', title: 'プライバシーポリシー', desc: '情報の取扱い' },
];
---

<BaseLayout title="カメコロ | 7ofu" description="カメコロの規約・ポリシー・お問い合わせ" width="wide">
  <p class="crumb"><a href="/">Home</a> / カメコロ</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section>
    <h2>規約・ポリシー</h2>
    <ul class="doclist">
      {docs.map((d) => (
        <li>
          <a href={d.href}>
            <strong>{d.title}</strong>
            <small>{d.desc}</small>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>お問い合わせ</h2>
    <ul class="doclist">
      <li>
        <a href="/kamekoro/contact">
          <strong>お問い合わせフォーム</strong>
          <small>要望・不具合の報告・ニックネームの通報など</small>
        </a>
      </li>
    </ul>
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doclist {
      list-style: none;
      padding: 0;
      margin: 0;
      max-width: 40rem;
      display: grid;
      gap: 1rem;
    }
    .doclist a {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1.15rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: white;
      text-decoration: none;
      color: var(--fg);
      transition: border-color 0.15s ease;
    }
    .doclist a:hover { border-color: var(--brand); }
    .doclist small { color: var(--muted); }
  </style>
</BaseLayout>
