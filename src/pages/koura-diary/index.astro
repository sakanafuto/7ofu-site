---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Spread from '../../components/Spread.astro';
import { getApp } from '../../data/apps';

const lang = 'ja';
const app = getApp('koura', lang);

const docs = [
  { href: '/koura-diary/terms', title: '利用規約', desc: 'アプリの利用条件' },
  { href: '/koura-diary/privacy', title: 'プライバシーポリシー', desc: '情報の取扱い' },
  { href: '/koura-diary/account-deletion', title: 'アカウントとデータの削除', desc: 'アカウント・データの削除方法' },
  { href: '/koura-diary/disclaimer', title: '免責事項', desc: '健康・栄養表示について' },
];
---

<BaseLayout title="こうら日記 | 7ofu" description="こうら日記のヘルプ・規約" width="wide">
  <p class="crumb"><a href="/">Home</a> / こうら日記</p>
  <Spread app={app} lang={lang} index={0} standalone eager />

  <section>
    <h2>使い方</h2>
    <ul class="doclist">
      <li>
        <a href="/koura-diary/help">
          <strong>使い方・ヘルプ</strong>
          <small>記録の付け方、家族との共有、バックアップ など</small>
        </a>
      </li>
    </ul>
  </section>

  <section>
    <h2>規約・ポリシー</h2>
    <ul class="doclist">
      {docs.map((d) => (
        <li>
          <a href={d.href}>
            <strong>{d.title}</strong>
            <small>{d.desc}</small>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .doclist {
      list-style: none;
      padding: 0;
      margin: 0;
      max-width: 40rem;
      display: grid;
      gap: 1rem;
    }
    .doclist a {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1.15rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: white;
      text-decoration: none;
      color: var(--fg);
      transition: border-color 0.15s ease;
    }
    .doclist a:hover { border-color: var(--brand); }
    .doclist small { color: var(--muted); }
  </style>
</BaseLayout>
