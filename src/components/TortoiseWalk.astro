---
// ヘッダー下端に重ねたトラックを、スクロール進捗に応じてカメが歩く演出（adr/0008・Home 専用）。
// 遊びはサイト内でここ 1 箇所に限定する。sticky ヘッダー（position:sticky の .site-header）の
// 内側に置く前提で、トラックはヘッダーの下端に絶対配置してスクロール追従させる（adr/0008 追記2）。
---

<div class="tortoise-track" aria-hidden="true">
  <div class="tortoise">
    <svg viewBox="0 0 28 20" width="28" height="20" aria-hidden="true">
      <ellipse class="tortoise__shell" cx="15" cy="10" rx="11" ry="7.5" />
      <circle class="tortoise__head" cx="25" cy="8" r="3" />
      <circle class="tortoise__leg" cx="5" cy="15.5" r="2.2" />
      <circle class="tortoise__leg" cx="11" cy="17" r="2.2" />
      <circle class="tortoise__leg" cx="19" cy="17" r="2.2" />
      <circle class="tortoise__leg" cx="24" cy="14.5" r="2.2" />
    </svg>
  </div>
</div>

<style>
  .tortoise-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 3px;
    background: var(--rule);
  }
  .tortoise {
    position: absolute;
    top: -13px;
    left: calc(var(--progress, 0) * (100% - 28px));
    width: 28px;
    height: 20px;
    pointer-events: none;
  }
  .tortoise svg {
    display: block;
  }
  .tortoise__shell,
  .tortoise__head,
  .tortoise__leg {
    fill: var(--brand);
  }
  .tortoise.walking .tortoise__leg {
    animation: tortoise-bob 260ms ease-in-out infinite alternate;
  }
  @keyframes tortoise-bob {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(1.2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tortoise.walking .tortoise__leg {
      animation: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.tortoise-track');
  const tortoise = document.querySelector<HTMLElement>('.tortoise');

  if (track && tortoise) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;
    let walkTimer: ReturnType<typeof setTimeout> | undefined;

    function updateProgress() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      track!.style.setProperty('--progress', String(progress));
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
      if (!reduceMotion) {
        tortoise!.classList.add('walking');
        clearTimeout(walkTimer);
        walkTimer = setTimeout(() => tortoise!.classList.remove('walking'), 150);
      }
    }

    updateProgress();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
