---
import {
  getLangFromUrl,
  useTranslations,
  localizePath,
  alternatePath,
  hasAlternate,
  languageShort,
  switchLangLabel,
} from '../i18n/ui';
import TortoiseWalk from '../components/TortoiseWalk.astro';

export interface Props {
  title: string;
  description?: string;
  /** 既定 'doc'（44rem・規約ページ）。Home / アプリ LP は 'wide'（72rem）を渡す（adr/0008）。 */
  width?: 'doc' | 'wide';
  /** ヘッダー直下にスクロール進捗で歩くカメを描画する（Home 専用の演出・adr/0008）。 */
  tortoise?: boolean;
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title,
  description = t('meta.siteDescription'),
  width = 'doc',
  tortoise = false,
} = Astro.props;

const nav = [
  { href: localizePath('/', lang), label: t('nav.home') },
  { href: localizePath('/koura-diary/', lang), label: t('nav.koura') },
  { href: localizePath('/schemely/', lang), label: t('nav.schemely') },
  { href: localizePath('/kamekoro/', lang), label: t('nav.kamekoro') },
  // ブログは ja のみ。en 記事が出たら en ナビにも出す（ui.ts の jaOnlyPrefixes と対で更新する）
  ...(lang === 'ja' ? [{ href: '/blog/', label: t('nav.blog') }] : []),
];
const otherLang = lang === 'ja' ? 'en' : 'ja';
// en 版が無いページ（ブログ等）では別 locale の同一ページが存在しないため、
// スイッチャは別 locale のトップへ逃がす（`/en/blog/...` 等の 404 を避ける）。
const alternateExists = hasAlternate(Astro.url.pathname);
const switchHref = alternateExists
  ? alternatePath(Astro.url.pathname, otherLang)
  : localizePath('/', otherLang);
// hreflang 用の絶対 URL（Astro.site = https://7ofu.dev）。
const jaHref = new URL(alternatePath(Astro.url.pathname, 'ja'), Astro.site).href;
const enHref = new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    {alternateExists && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={jaHref} />
    <title>{title}</title>
    <!-- Lism CSS（デザインフレームワーク・#75）。デザイントークン/タイポグラフィのベース。 -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/lism-css@0/dist/css/main.css"
    />
    <!-- 観察ノートの世界観フォント（adr/0008）。見出し・英字は Inter、本文は Noto Sans JP、
         手書き風ラベルのみ Zen Kurenaido。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800&family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kurenaido&display=swap"
    />
    <style is:global>
      :root {
        --site-max: 44rem;
        --site-max-wide: 72rem;
        --brand: #41592d;
        --bg: #fbf7ee;
        --fg: #2c2c2c;
        --muted: #6b6b6b;
        --line: #e6e0d3;
        /* 観察ノートの世界観トークン（adr/0008）。 */
        --paper-2: #f4eddc;
        --rule: rgba(65, 89, 45, 0.1);
        --acc-koura: #4a7029;
        --tint-koura: #e9f0dc;
        --acc-schemely: #1f7358;
        --tint-schemely: #dff4ec;
        --acc-kamekoro: #9c5412;
        --tint-kamekoro: #fdefcf;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family:
          'Noto Sans JP', system-ui, -apple-system, 'Hiragino Sans', sans-serif;
        line-height: 1.8;
      }
      .display {
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 800;
      }
      .label-hand {
        font-family: 'Zen Kurenaido', 'Noto Sans JP', sans-serif;
        font-weight: 400;
      }
      .container {
        max-width: var(--site-max);
        margin-inline: auto;
        padding-inline: 1.5rem;
      }
      .container--wide {
        max-width: var(--site-max-wide);
      }
      /* .reveal の出現演出（adr/0008）。JS 無効時は html.js が付かないため常時表示のまま。 */
      .reveal {
        transition:
          opacity 600ms cubic-bezier(0.2, 0.7, 0.2, 1),
          translate 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      html.js .reveal {
        opacity: 0;
        translate: 0 18px;
      }
      /* `.reveal.is-in` だけだと `html.js .reveal`（要素 1＋クラス 2）に詳細度で負け、
         is-in が付いても透明のまま残る。必ず html.js を前置して同じ詳細度以上にする。 */
      html.js .reveal.is-in {
        opacity: 1;
        translate: 0 0;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal {
          transition: none;
        }
        html.js .reveal {
          opacity: 1;
          translate: 0 0;
        }
      }
      .site-header {
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg) 80%, white);
        position: sticky;
        top: 0;
        backdrop-filter: blur(6px);
      }
      .site-header .container {
        display: flex;
        align-items: center;
        gap: 0.6rem 1.25rem;
        min-height: 3.5rem;
      }
      .brand {
        font-weight: 700;
        color: var(--brand);
        text-decoration: none;
        font-size: 1.05rem;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-inline-start: auto;
      }
      .site-nav a {
        color: var(--fg);
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
      }
      .site-nav a:hover { color: var(--brand); }
      .lang-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.2rem 0.65rem;
        font-size: 0.82rem;
        color: var(--muted);
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .lang-switch__icon { opacity: 0.85; }
      .lang-switch:hover { border-color: var(--brand); color: var(--brand); }

      /* モバイルは 2 段ヘッダー: 1 段目=ロゴ+言語トグル / 2 段目=nav をセンタリング。 */
      @media (max-width: 40rem) {
        .site-header .container {
          flex-wrap: wrap;
          padding-block: 0.55rem;
          min-height: 0;
        }
        .site-nav {
          order: 1;
          flex-basis: 100%;
          justify-content: center;
          gap: 1.25rem;
          margin-inline-start: 0;
        }
        .lang-switch { margin-inline-start: auto; }
      }
      main { padding-block: 4rem 6rem; }
      p { margin-block: 1.1rem; }
      .site-footer {
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.85rem;
      }
      .site-footer .container { padding-block: 1.5rem; }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .footer-x {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        text-decoration: none;
      }
      .footer-x:hover { color: var(--brand); }
      .footer-x__label { font-size: 0.82rem; }
      a { color: var(--brand); }
      h1 { font-size: 1.7rem; line-height: 1.45; margin: 0 0 1rem; }
      h2 {
        font-size: 1.2rem;
        line-height: 1.5;
        margin: 3.25rem 0 1.5rem;
        border-left: 4px solid var(--brand);
        padding-left: 0.7rem;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={localizePath('/', lang)} class="brand">7ofu</a>
        <nav class="site-nav">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <a
          class="lang-switch"
          href={switchHref}
          hreflang={otherLang}
          rel="alternate"
          aria-label={switchLangLabel[lang]}
        >
          <svg
            class="lang-switch__icon"
            viewBox="0 0 24 24"
            width="1em"
            height="1em"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3c2.6 2.5 4 5.6 4 9s-1.4 6.5-4 9c-2.6-2.5-4-5.6-4-9s1.4-6.5 4-9z" />
          </svg>
          <span>{languageShort[otherLang]}</span>
        </a>
      </div>
    </header>
    {tortoise && <TortoiseWalk />}
    <main>
      <div class:list={['container', { 'container--wide': width === 'wide' }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 7ofu</span>
        <a
          class="footer-x"
          href="https://x.com/KouraDiary"
          target="_blank"
          rel="noopener"
          aria-label="こうら日記・カメコロの公式X（旧Twitter）"
        >
          <svg
            viewBox="0 0 24 24"
            width="1em"
            height="1em"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
          <span class="footer-x__label">@KouraDiary</span>
        </a>
      </div>
    </footer>
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
